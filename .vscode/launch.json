{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ST-Link",
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "stlink",
            "interface": "swd",
            "showDevDebugOutput": "both",
            "v1": false,                            // ST-Link version
            "device": "STM32L053R8T",                // MCU used [optional]
            // "serialNumber": "",                     // Set ST-Link ID if you use multiple at the same time [optional]
            "runToEntryPoint": "main",              // Run to main and stop there [optional]
            "svdFile": "target_nucleo_l053r8/STM32L0_svd/STM32L0_svd_v1r4/STM32L053.svd"    // SVD file to see registers [optional]
        }
    ]
}
